{
	"schemaVersion": 1,
	"id": "minigamebots-training",
	"version": "${version}",
	"name": "MinigameBots Training Grounds",
	"description": "Training rooms for MinigameBots AIs: arenas, instant resets, practice targets, drills and opponents. Runs on servers and in singleplayer.",
	"authors": ["mudklip"],
	"icon": "assets/minigamebots-training/icon.png",
	"contact": {
		"sources": "https://github.com/mudklip/MinigameBots"
	},
	"license": "All-Rights-Reserved",
	"environment": "*",
	"entrypoints": {
		"main": ["io.github.mudklip.minigamebots.training.TrainingGrounds"]
	},
	"mixins": [
		"minigamebots-training.mixins.json"
	],
	"depends": {
		"fabricloader": ">=${loader_version}",
		"minecraft": "~${minecraft_version}",
		"java": ">=25",
		"fabric-api": "*"
	}
}
