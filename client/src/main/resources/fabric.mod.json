{
	"schemaVersion": 1,
	"id": "minigamebots",
	"version": "${version}",
	"name": "MinigameBots",
	"description": "A Minecraft AI that learns any in-game skill, from building to PvP, and plays through real keyboard and mouse input.",
	"authors": ["mudklip"],
	"contact": {
		"sources": "https://github.com/mudklip/MinigameBots"
	},
	"license": "All-Rights-Reserved",
	"environment": "client",
	"entrypoints": {
		"client": ["io.github.mudklip.minigamebots.client.MinigameBotsClient"]
	},
	"depends": {
		"fabricloader": ">=${loader_version}",
		"minecraft": "~${minecraft_version}",
		"java": ">=25",
		"fabric-api": "*"
	}
}
