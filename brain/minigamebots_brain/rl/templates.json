{
  "duel": {
    "name": "Duel",
    "description": "Win fights: kills and round wins count most; taking hits is forgiven if it wins.",
    "rules": [
      {
        "event": "tg_episode_end",
        "where": {
          "result": "win"
        },
        "value": 10,
        "tier": 1,
        "note": "round won"
      },
      {
        "event": "tg_episode_end",
        "where": {
          "result": "loss"
        },
        "value": -5,
        "tier": 1,
        "note": "round lost"
      },
      {
        "event": "kill",
        "value": 3,
        "tier": 1,
        "note": "kill"
      },
      {
        "event": "damage_dealt",
        "value": 0.1,
        "per": "amount",
        "cap": 6,
        "tier": 2,
        "note": "hit"
      },
      {
        "event": "damage_taken",
        "value": -0.05,
        "per": "amount",
        "tier": 3,
        "note": "hurt",
        "forgive": {
          "by": [
            "kill",
            {
              "event": "tg_episode_end",
              "where": {
                "result": "win"
              }
            }
          ],
          "within": 20
        }
      },
      {
        "event": "death",
        "value": -3,
        "tier": 1,
        "note": "died"
      },
      {
        "event": "second",
        "value": -0.002,
        "tier": 4,
        "note": "stalling"
      }
    ]
  },
  "hunt": {
    "name": "Hunt {target}",
    "description": "Find and kill {target}.",
    "params": {
      "target": "minecraft:pig"
    },
    "rules": [
      {
        "event": "kill",
        "where": {
          "target": "{target}"
        },
        "value": 5,
        "tier": 1,
        "note": "kill"
      },
      {
        "event": "damage_dealt",
        "where": {
          "target": "{target}"
        },
        "value": 0.2,
        "per": "amount",
        "cap": 4,
        "tier": 2,
        "note": "hit"
      },
      {
        "event": "death",
        "value": -5,
        "tier": 1,
        "note": "died"
      },
      {
        "event": "second",
        "value": -0.001,
        "tier": 4,
        "note": "time"
      }
    ]
  },
  "survive": {
    "name": "Survive",
    "description": "Stay alive; some damage is fine, but not too much each round.",
    "rules": [
      {
        "event": "second",
        "where": {
          "dead": false
        },
        "value": 0.02,
        "cap": 6,
        "tier": 2,
        "note": "alive"
      },
      {
        "event": "death",
        "value": -10,
        "tier": 1,
        "note": "died"
      },
      {
        "event": "damage_taken",
        "value": 0.1,
        "per": "amount",
        "budget": {
          "limit": 10
        },
        "tier": 2,
        "note": "damage over budget"
      }
    ]
  },
  "aim": {
    "name": "Aim trainer",
    "description": "Hit aim-trainer targets fast and accurately.",
    "rules": [
      {
        "event": "tg_aim_hit",
        "value": 1,
        "tier": 1,
        "note": "target hit"
      },
      {
        "event": "tg_aim_result",
        "value": 5,
        "per": "accuracy",
        "tier": 1,
        "note": "accuracy"
      },
      {
        "event": "attack",
        "value": -0.02,
        "tier": 3,
        "note": "swing"
      }
    ]
  },
  "crit_drill": {
    "name": "Crit drill",
    "description": "Critical hits (jump, hit while falling, fully charged). Use against a stationary or L2 dummy.",
    "rules": [
      {
        "event": "tg_damage_dealt",
        "where": {
          "crit": true
        },
        "value": 1.0,
        "tier": 1,
        "note": "crit"
      },
      {
        "event": "tg_damage_dealt",
        "where": {
          "crit": false,
          "charge": {
            "min": 0.9
          }
        },
        "value": 0.2,
        "tier": 2,
        "note": "charged hit"
      },
      {
        "event": "tg_damage_dealt",
        "where": {
          "charge": {
            "max": 0.6
          }
        },
        "value": -0.3,
        "tier": 2,
        "note": "spam-clicked hit"
      },
      {
        "event": "second",
        "value": -0.01,
        "tier": 4,
        "note": "stalling"
      }
    ]
  },
  "wtap_drill": {
    "name": "W-tap drill",
    "description": "Sprint hits for extra knockback: let go of forward (or tap S) after each hit, sprint back in.",
    "rules": [
      {
        "event": "tg_damage_dealt",
        "where": {
          "sprint_hit": true,
          "charge": {
            "min": 0.9
          }
        },
        "value": 1.0,
        "tier": 1,
        "note": "sprint hit"
      },
      {
        "event": "tg_damage_dealt",
        "where": {
          "sprint_hit": false
        },
        "value": 0.1,
        "tier": 2,
        "note": "plain hit"
      },
      {
        "event": "damage_taken",
        "value": -0.05,
        "per": "amount",
        "tier": 3,
        "note": "hurt",
        "forgive": {
          "by": [
            {
              "event": "tg_damage_dealt",
              "where": {
                "sprint_hit": true
              }
            }
          ],
          "within": 20
        }
      },
      {
        "event": "second",
        "value": -0.01,
        "tier": 4,
        "note": "stalling"
      }
    ]
  },
  "shield_drill": {
    "name": "Shield-break drill",
    "description": "Against a blocker dummy: hit a raised shield with an axe to disable it, then follow up.",
    "rules": [
      {
        "event": "tg_damage_dealt",
        "where": {
          "shield_disabled": true
        },
        "value": 2.0,
        "tier": 1,
        "note": "shield disabled"
      },
      {
        "event": "tg_damage_dealt",
        "where": {
          "blocked": false
        },
        "value": 0.1,
        "per": "amount",
        "cap": 4,
        "tier": 2,
        "note": "hit landed"
      },
      {
        "event": "tg_damage_dealt",
        "where": {
          "blocked": true,
          "shield_disabled": false
        },
        "value": -0.2,
        "tier": 2,
        "note": "hit the shield"
      },
      {
        "event": "second",
        "value": -0.01,
        "tier": 4,
        "note": "stalling"
      }
    ]
  }
}
