        "where": {
          "result": "loss"
        },
        "value": -5,
        "tier": 1,
        "note": "round lost"
      },
      {
        "event": "kill",
        "value": 3,
        "tier": 1,
        "note": "kill"
      },
      {
        "event": "damage_dealt",
        "value": 0.1,
        "per": "amount",
        "cap": 6,
        "tier": 2,
        "note": "hit"
      },
      {
        "event": "damage_taken",
        "value": -0.05,
        "per": "amount",
        "tier": 3,
        "note": "hurt",
        "forgive": {
          "by": [
            "kill",
            {
              "event": "tg_episode_end",
              "where": {
                "result": "win"
              }
            }
